  <hospital random_tag="object_sets" set_name="medevac_land_hospital" >
    <q id="hospital" wp_type="land" next_tag=""><![CDATA[
      [out:xml][timeout:25][bbox:{{all_bbox}}];
      (
      nwr["amenity"="hospital"]["emergency"="yes"]({{all_bbox}});
      );
      out body;
      ]]></q>
  </hospital>

  <icao random_tag="object_sets" set_name="medevac_land_icao" >
    <q id="helipad" wp_type="land" next_tag=""><![CDATA[
      [out:xml][timeout:25][bbox:{{all_bbox}}];
      (
      nwr['aeroway'='helipad']({{all_bbox}});
      );
      out body;
      ]]></q>
  </icao>

